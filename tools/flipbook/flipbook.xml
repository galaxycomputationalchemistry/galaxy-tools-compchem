<tool id="flipbook" name="Flipbook trajectory analysis" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="26.0">
    <description>time-sliced residue fluctuation analysis</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <xrefs>
        <xref type="bio.tools">rmsx_and_flipbook</xref>
    </xrefs>
    <expand macro="requirements"/>
    <required_files>
        <include path="rmsx_preflight.py"/>
        <include path="rmsx_multichain.py"/>
        <include path="rmsx_static_plots.py"/>
        <include path="flipbook_molstar_report.py"/>
        <include path="flipbook_report_common.py"/>
        <include path="test-data/1UBQ.pdb"/>
        <include path="test-data/mon_sys.xtc"/>
    </required_files>
    <version_command><![CDATA[python3 -c "import importlib.metadata; print(importlib.metadata.version('rmsx'))"]]></version_command>
    <command detect_errors="exit_code"><![CDATA[
        mkdir -p rmsx_output galaxy_outputs &&
        #if str($input_source.source) == "example"
            ln -s '$__tool_directory__/test-data/1UBQ.pdb' input_topology.pdb &&
            ln -s '$__tool_directory__/test-data/mon_sys.xtc' input_trajectory.xtc &&
            topology_path='input_topology.pdb' &&
            trajectory_path='input_trajectory.xtc' &&
        #else
            ln -s '$input_source.topology' 'input_topology.$input_source.topology.ext' &&
            ln -s '$input_source.trajectory' 'input_trajectory.$input_source.trajectory.ext' &&
            topology_path='input_topology.$input_source.topology.ext' &&
            trajectory_path='input_trajectory.$input_source.trajectory.ext' &&
        #end if
        #if str($input_source.chain_scope.mode) == "all"
            chain_selector='all' &&
        #else
            chain_selector='$input_source.chain_scope.chain' &&
        #end if
        python3 '$__tool_directory__/rmsx_preflight.py'
            --topology "\${topology_path}"
            --trajectory "\${trajectory_path}"
            --selector "\${chain_selector}"
            --num-slices '$input_source.num_slices'
            --start-frame '$analysis.start_frame'
            #if str($analysis.end_frame).strip() not in ("", "None")
                --end-frame '$analysis.end_frame'
            #end if
            --analysis-type '$analysis.analysis_type'
            > '$log' 2>&1 &&
        RMSX_NO_CITATION=1 python3 '$__tool_directory__/rmsx_multichain.py'
            --topology "\${topology_path}"
            --trajectory "\${trajectory_path}"
            --output-dir rmsx_output
            --galaxy-output-dir galaxy_outputs
            --chain-mode '$input_source.chain_scope.mode'
            #if str($input_source.chain_scope.mode) == "selected"
                --chains '$input_source.chain_scope.chain'
            #end if
            --num-slices '$input_source.num_slices'
            --start-frame '$analysis.start_frame'
            #if str($analysis.end_frame).strip() not in ("", "None")
                --end-frame '$analysis.end_frame'
            #end if
            --analysis-type '$analysis.analysis_type'
            --summary-n '$analysis.summary_n'
            --palette '$palette'
            #if str($analysis.interpolate) == "--interpolate"
                --interpolate
            #end if
            --plot-helper '$__tool_directory__/rmsx_static_plots.py'
            >> '$log' 2>&1 &&
        python3 '$__tool_directory__/flipbook_molstar_report.py'
            --pdb-dir galaxy_outputs/pdb_slices
            --rmsx-table galaxy_outputs/combined_rmsx.csv
            --mask-table galaxy_outputs/combined_mask.csv
            --rmsd-dir galaxy_outputs/rmsd_tables
            --rmsf-dir galaxy_outputs/rmsf_tables
            --chain-index galaxy_outputs/viewer_chain_index.json
            --palette '$palette'
            --manifest-output '$viewer_manifest'
            --title 'RMSX Flipbook viewer'
    ]]></command>
    <inputs>
        <conditional name="input_source">
            <param name="source" type="select" display="radio" label="Input source">
                <option value="history">Use datasets from history</option>
                <option value="example" selected="true">Load example data: 1UBQ plus mon_sys</option>
            </param>
            <when value="history">
                <param name="topology" type="data" format="pdb" label="Topology or structure file" help="The current wrapper supports PDB topology/structure input. Broader MDAnalysis-readable topology formats are tracked as follow-up work."/>
                <param name="trajectory" type="data" format="dcd,xtc" label="Trajectory file" help="The current wrapper supports DCD and XTC trajectory input. Broader MDAnalysis-readable trajectory formats are tracked as follow-up work."/>
                <conditional name="chain_scope">
                    <param name="mode" type="select" label="Chains to analyze">
                        <option value="all" selected="true">All valid chains</option>
                        <option value="selected">Selected chains or segments</option>
                    </param>
                    <when value="all"/>
                    <when value="selected">
                        <param argument="--chain" type="text" value="A" label="Chain/segment selectors" help="Enter one or more comma-separated chain or segment IDs, such as A,B. The preflight check reports the available IDs.">
                            <validator type="regex" message="Use comma-separated letters, numbers, underscores, hyphens, or periods.">^[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+)*$</validator>
                        </param>
                    </when>
                </conditional>
                <param argument="--num_slices" type="integer" value="9" min="1" label="Number of trajectory slices"/>
            </when>
            <when value="example">
                <conditional name="chain_scope">
                    <param name="mode" type="select" label="Chains to analyze">
                        <option value="all" selected="true">All valid chains</option>
                        <option value="selected">Selected chains or segments</option>
                    </param>
                    <when value="all"/>
                    <when value="selected">
                        <param argument="--chain" type="text" value="7" label="Chain/segment selectors" help="The bundled 1UBQ/mon_sys example uses segment ID 7.">
                            <validator type="regex" message="Use comma-separated letters, numbers, underscores, hyphens, or periods.">^[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+)*$</validator>
                        </param>
                    </when>
                </conditional>
                <param argument="--num_slices" type="integer" value="9" min="1" label="Number of trajectory slices"/>
            </when>
        </conditional>
        <section name="analysis" title="RMSX analysis options" expanded="false">
            <param argument="--start_frame" type="integer" value="0" min="0" label="Start frame" help="Zero-based first trajectory frame to include."/>
            <param argument="--end_frame" type="integer" optional="true" min="0" label="End frame" help="Optional zero-based last trajectory frame to include. Leave blank to analyze through the final frame."/>
            <param argument="--analysis_type" type="select" label="Analysis type" help="Passed to RMSX with --analysis_type. The default protein mode matches the current RMSX/Flipbook path.">
                <option value="protein" selected="true">Protein</option>
                <option value="dna">DNA</option>
                <option value="rna">RNA</option>
                <option value="generic">Generic</option>
            </param>
            <param argument="--summary_n" type="integer" value="3" min="1" label="Summary residue count" help="Number of top-changing residues RMSX should include in its summary outputs."/>
            <param argument="--interpolate" type="boolean" checked="false" truevalue="--interpolate" falsevalue="--no-interpolate" label="Interpolate RMSX slice values" help="Disabled by default to preserve the current validated wrapper behavior."/>
        </section>
        <param argument="--palette" type="select" label="Molstar and plot color palette" help="Initial color ramp used by the native Galaxy Molstar Flipbook visualization and the static RMSX heatmap/triple plots.">
            <option value="viridis" selected="true">Viridis</option>
            <option value="magma">Magma</option>
            <option value="inferno">Inferno</option>
            <option value="plasma">Plasma</option>
            <option value="cividis">Cividis</option>
            <option value="rocket">Rocket</option>
            <option value="mako">Mako</option>
            <option value="turbo">Turbo</option>
        </param>
    </inputs>
    <outputs>
        <collection type="list" name="rmsx_tables" label="${tool.name} on ${on_string}: per-chain RMSX tables">
            <discover_datasets directory="galaxy_outputs/rmsx_tables" pattern="(?P&lt;designation&gt;chain_.+)\.csv" ext="csv"/>
        </collection>
        <collection type="list" name="rmsd_tables" label="${tool.name} on ${on_string}: per-chain RMSD tables">
            <discover_datasets directory="galaxy_outputs/rmsd_tables" pattern="(?P&lt;designation&gt;chain_.+)\.csv" ext="csv"/>
        </collection>
        <collection type="list" name="rmsf_tables" label="${tool.name} on ${on_string}: per-chain RMSF tables">
            <discover_datasets directory="galaxy_outputs/rmsf_tables" pattern="(?P&lt;designation&gt;chain_.+)\.csv" ext="csv"/>
        </collection>
        <collection type="list" name="mask_tables" label="${tool.name} on ${on_string}: per-chain mask metadata">
            <discover_datasets directory="galaxy_outputs/mask_tables" pattern="(?P&lt;designation&gt;chain_.+)\.csv" ext="csv"/>
        </collection>
        <collection type="list" name="pdb_slices" label="${tool.name} on ${on_string}: PDB slices">
            <discover_datasets directory="galaxy_outputs/pdb_slices" pattern="(?P&lt;designation&gt;slice_[0-9]+_first_frame)\.pdb" ext="pdb"/>
        </collection>
        <collection type="list" name="heatmap_plots" label="${tool.name} on ${on_string}: per-chain RMSX heatmaps">
            <discover_datasets directory="galaxy_outputs/heatmap_plots" pattern="(?P&lt;designation&gt;chain_.+)\.png" ext="png"/>
        </collection>
        <collection type="list" name="triple_plots" label="${tool.name} on ${on_string}: per-chain RMSX triple plots">
            <discover_datasets directory="galaxy_outputs/triple_plots" pattern="(?P&lt;designation&gt;chain_.+)\.png" ext="png"/>
        </collection>
        <data name="log" format="txt" label="${tool.name} on ${on_string}: execution log"/>
        <data name="viewer_manifest" format="rmsx.json" label="${tool.name} on ${on_string}: RMSX Flipbook viewer manifest - open with Visualize"/>
    </outputs>
