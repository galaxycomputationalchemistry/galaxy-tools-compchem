            <test expect_num_outputs="4">
            <param name="pdb" value="system.pdb" />
            <conditional name="box_mode_cond">
                <param name="box_mode" value="auto" />
                <param name="buffer" value="10.0" />
            </conditional>
            <conditional name="ligand_cond">
                <param name="ligand_select" value="no" />
            </conditional>
            <output name="out_parm7" file="1_system_parm7.txt" ftype="txt">
                <assert_contents>
                    <has_text text="%FLAG IPOL" />
                </assert_contents>
            </output>
            <output name="out_box_rst7" file="1_system_box_rst7.txt" ftype="txt">
                <assert_contents>
                    <has_text text="7168" />
                </assert_contents>
            </output>
            <output name="out_leap_pdb" file="1_system_leap.pdb" ftype="pdb">
                <assert_contents>
                    <has_text text="ATOM" />
                </assert_contents>
            </output>
            <output name="out_clean_pdb" file="1_system_clean.pdb" ftype="pdb">
                <assert_contents>
                    <has_text text="ATOM" />
                </assert_contents>
            </output>
        </test>
