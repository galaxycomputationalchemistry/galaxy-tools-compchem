<tool id="amber_vdw_bounding_box" name="Prepare AMBER System for Solvation" version="1.0.0">
    <description>build a tleap system, size a VDW bounding box, and box the restart file with ChBox</description>

    <requirements>
        <requirement type="package" version="26.0">ambertools</requirement>
        <requirement type="package" version="2.4.6">numpy</requirement>
    </requirements>

    <command detect_errors="exit_code"><![CDATA[
        python3 '$__tool_directory__/bounding_box.py'
            --pdb '$pdb'
            #if $box_mode_cond.box_mode == 'auto'
                --buffer $box_mode_cond.buffer
            #else if $box_mode_cond.box_mode == 'manual'
                --manual-box-x $box_mode_cond.box_x
                --manual-box-y $box_mode_cond.box_y
                --manual-box-z $box_mode_cond.box_z
                --manual-box-alpha $box_mode_cond.box_alpha
                --manual-box-beta $box_mode_cond.box_beta
                --manual-box-gamma $box_mode_cond.box_gamma
            #end if
            #if $ligand_cond.ligand_select == 'yes'
                --frcmod '$ligand_cond.frcmod'
                --mol2 '$ligand_cond.mol2'
            #end if
            --clean-pdb protein_clean.pdb
            --leap-pdb protein_leap.pdb
            --box-rst7 protein_box.rst7
    ]]></command>

    <inputs>
        <param name="pdb" type="data" format="pdb" label="Input PDB file"
               help="Protein structure, optionally with a co-crystallized ligand or other hetero groups (HETATM records)." />

        <conditional name="box_mode_cond">
            <param name="box_mode" type="select" label="Bounding Box Mode"
                   help="Choose 'Auto' to calculate box dimensions from protein coordinates, or 'Manual' to enter box dimensions directly (e.g., from crystallography data).">
                <option value="auto" selected="true">Auto (calculate from protein)</option>
                <option value="manual">Manual (enter X, Y, Z dimensions)</option>
            </param>
            <when value="auto">
                <param name="buffer" type="float" value="10.0" min="0" label="Buffer added on each side of the VDW box (A)"
                       help="Buffer size in Angstroms added to each side of the calculated protein bounding box." />
            </when>
            <when value="manual">
                <param name="box_x" type="float" label="Box X dimension (A)"
                       help="X dimension of the bounding box in Angstroms (from crystallography data)." />
                <param name="box_y" type="float" label="Box Y dimension (A)"
                       help="Y dimension of the bounding box in Angstroms (from crystallography data)." />
                <param name="box_z" type="float" label="Box Z dimension (A)"
                       help="Z dimension of the bounding box in Angstroms (from crystallography data)." />
                <param name="box_alpha" type="float" value="90.0" min="0" max="180" label="Alpha angle (degrees)"
                       help="Alpha angle of the unit cell in degrees (default: 90.0). From crystallography CRYST1 record." />
                <param name="box_beta" type="float" value="90.0" min="0" max="180" label="Beta angle (degrees)"
                       help="Beta angle of the unit cell in degrees (default: 90.0). From crystallography CRYST1 record." />
                <param name="box_gamma" type="float" value="90.0" min="0" max="180" label="Gamma angle (degrees)"
                       help="Gamma angle of the unit cell in degrees (default: 90.0). From crystallography CRYST1 record." />
            </when>
        </conditional>

        <conditional name="ligand_cond">
            <param name="ligand_select" type="select" label="Include a ligand?"
                   help="Choose Yes to merge a ligand into the system from its own mol2 coordinates and frcmod parameters.">
                <option value="no" selected="true">No (protein only)</option>
                <option value="yes">Yes</option>
            </param>
            <when value="no" />
            <when value="yes">
                <param name="frcmod" type="data" format="txt" label="Ligand frcmod file" />
                <param name="mol2" type="data" format="mol2" label="Ligand mol2 file" />
            </when>
        </conditional>
    </inputs>

    <outputs>
        <data name="out_parm7" format="txt" from_work_dir="protein.parm7" label="${tool.name} on ${on_string}: parm7" />
        <data name="out_box_rst7" format="txt" from_work_dir="protein_box.rst7" label="${tool.name} on ${on_string}: boxed rst7" />
        <data name="out_leap_pdb" format="pdb" from_work_dir="protein_leap.pdb" label="${tool.name} on ${on_string}: leap pdb" />
        <data name="out_clean_pdb" format="pdb" from_work_dir="protein_clean.pdb" label="${tool.name} on ${on_string}: protein-only cleaned pdb" />
    </outputs>

